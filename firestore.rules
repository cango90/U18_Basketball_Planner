rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    // Berk is the initial trainer; every further trainer is explicitly recorded.
    function coach() {
      return signedIn() && (request.auth.token.email == 'berk@teamplaner.invalid' ||
        get(/databases/$(database)/documents/team_memberships/$(request.auth.uid)).data.role in ['coach', 'club_admin']);
    }
    function dutyBefore(dutyId) { return get(/databases/$(database)/documents/duty_assignments/$(dutyId)).data; }
    function dutyAfter(dutyId) { return getAfter(/databases/$(database)/documents/duty_assignments/$(dutyId)).data; }
    function ownAttendance() { return signedIn() && request.resource.data.user_id == request.auth.uid; }

    match /team_memberships/{memberId} {
      allow read: if signedIn() && (memberId == request.auth.uid || coach());
      allow create, update, delete: if coach();
    }
    match /roster_entries/{entryId} {
      allow read: if signedIn();
      allow create, update, delete: if coach();
    }
    match /events/{eventId} {
      allow read: if signedIn();
      allow create, update, delete: if coach();
    }
    match /attendance/{attendanceId} {
      allow read: if signedIn();
      allow create: if coach() || ownAttendance();
      allow update: if coach() || (signedIn() && resource.data.user_id == request.auth.uid && ownAttendance());
      allow delete: if coach();
    }
    match /duty_assignments/{dutyId} {
      allow read: if signedIn();
      allow create, delete: if coach();
      allow update: if coach() || (signedIn() && (
        (resource.data.assigned_to == null && request.resource.data.assigned_to == request.auth.uid &&
          request.resource.data.status == 'claimed' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['assigned_to', 'assigned_name', 'status', 'claimed_at'])) ||
        (resource.data.assigned_to == request.auth.uid && request.resource.data.assigned_to == null &&
          request.resource.data.status == 'open' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['assigned_to', 'assigned_name', 'status', 'claimed_at', 'withdrawn_at']))
      ));
    }
    match /duty_history/{historyId} {
      allow read: if coach();
      allow create: if coach() || (signedIn() && request.resource.data.player_id == request.auth.uid && (
        (request.resource.data.action == 'claimed' &&
          dutyBefore(request.resource.data.duty_id).assigned_to == null &&
          dutyAfter(request.resource.data.duty_id).assigned_to == request.auth.uid &&
          dutyAfter(request.resource.data.duty_id).status == 'claimed') ||
        (request.resource.data.action == 'withdrawn' &&
          dutyBefore(request.resource.data.duty_id).assigned_to == request.auth.uid &&
          dutyAfter(request.resource.data.duty_id).assigned_to == null &&
          dutyAfter(request.resource.data.duty_id).status == 'open')
      ));
      allow update, delete: if coach();
    }
    match /messages/{messageId} {
      allow read: if signedIn();
      allow create, update, delete: if coach();
    }
    match /game_results/{resultId} { allow read: if signedIn(); allow write: if coach(); }
    match /player_game_stats/{statId} {
      allow read: if coach() || (signedIn() && resource.data.user_id == request.auth.uid);
      allow write: if coach();
    }
    match /player_profiles/{userId} {
      allow read: if signedIn() && (userId == request.auth.uid || coach());
      allow create, update: if signedIn() && userId == request.auth.uid;
      allow delete: if coach();
    }
    match /access_requests/{requestId} { allow read, write: if coach(); }
  }
}
